# Shared config: docker compose and local frontend development.
# frontend/.env.local overrides these locally.

######################################################################
# Common
######################################################################

# qlever | virtuoso | oxigraph
TRIPLESTORE_PROVIDER=qlever

# SPARQL query endpoint of the triplestore
SPARQL_ENDPOINT=

# Query abort timeout, milliseconds
SPARQL_TIMEOUT_MS=60000

# Display name in the sidebar and login page
WORKBENCH_NAME=RDF Workbench

# Public origin, allowlisted for same-origin mutations
WORKBENCH_URL=http://localhost:3000

# Host port of the workbench container
WORKBENCH_PORT=3000

# Base of dereferenceable resource IRIs, e.g. /person/<id>. Required
RESOURCE_BASE_URI=

# SQLite file with accounts, sessions, saved queries, prefixes
WORKBENCH_DB_PATH=./data/workbench.sqlite

# 1 or true lets logged-out visitors open read-only pages
ALLOW_ANONYMOUS_READ=

# 1 or true lets logged-out visitors chat with the ask assistant
ALLOW_ANONYMOUS_ASK=

######################################################################
# Ask assistant
######################################################################

# OpenAI-compatible API; empty AI_BASE_URL disables it
AI_BASE_URL=

# API key for AI_BASE_URL
AI_API_KEY=

# Chat model name
AI_MODEL=

# Optional tuning
# AI_MAX_STEPS=10
# AI_QUERY_TIMEOUT_MS=30000
# AI_RESULT_LIMIT=1000
# AI_PROFILE_MAX_CLASSES=60
# AI_PROFILE_MAX_PROPERTIES=30
# AI_PROFILE_MAX_SAMPLES=3

######################################################################
# Local accounts (QLever and Oxigraph)
######################################################################

# Initial admin, created when the users table is empty
BOOTSTRAP_ADMIN_USERNAME=admin

# Password of that admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-at-least-12-characters

######################################################################
# QLever
######################################################################

# Server access token, enables the running-queries monitor
QLEVER_ACCESS_TOKEN=

######################################################################
# Oxigraph
######################################################################

# Host port of the oxigraph container; SPARQL lives at /sparql
OXIGRAPH_PORT=7878

######################################################################
# Virtuoso
######################################################################

# URL of the virtuoso-adapter service
VIRTUOSO_ADAPTER_URL=http://localhost:50118

# Bearer token shared between workbench and adapter
VIRTUOSO_ADAPTER_TOKEN=replace-with-at-least-32-characters

# Container path for graph export artifacts
VIRTUOSO_EXPORT_BASE_PATH=./imports/exports

# Max dump file size, bytes
GRAPH_EXPORT_FILE_LIMIT=50000000000

# Poll interval while waiting for dump files, ms
GRAPH_EXPORT_POLL_INTERVAL_MS=1000

# Poll attempts before giving up
GRAPH_EXPORT_POLL_ATTEMPTS=60

# Virtuoso host as seen from the adapter
VIRTUOSO_HOST=host.docker.internal

# ISQL port of the Virtuoso server
VIRTUOSO_ISQL_PORT=1111

# Virtuoso account the adapter uses for all of its database access
VIRTUOSO_DBA_USER=dba

# Password for that account
VIRTUOSO_DBA_PASSWORD=replace-this-password

# ODBC driver path inside the adapter image
VIRTUOSO_DRIVER=/usr/lib/odbc/virtodbc.so

# Connection timeout, seconds
VIRTUOSO_CONNECTION_TIMEOUT=30

# Login timeout, seconds
VIRTUOSO_LOGIN_TIMEOUT=10

# Import staging path inside the adapter
VIRTUOSO_IMPORTS_PATH=./imports

# Host bind mount for imports
VIRTUOSO_IMPORTS_HOST_PATH=./virtuoso-database/imports

# Max upload size, bytes
VIRTUOSO_ADAPTER_MAX_UPLOAD_BYTES=107374182400
