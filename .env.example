# Shared by Docker Compose and local frontend development.
# frontend/.env.local overrides these values locally.

######################################################################
# Common
######################################################################

# Triplestore backend: qlever, virtuoso, oxigraph, or generic
TRIPLESTORE_PROVIDER=qlever

# SPARQL query endpoint
SPARQL_ENDPOINT=

# Query timeout in milliseconds
SPARQL_TIMEOUT_MS=60000

# Name shown in the sidebar and login page
WORKBENCH_NAME=RDF Workbench

# Public origin allowed for same-origin mutations
WORKBENCH_URL=http://localhost:3000

# Host port for the workbench container
WORKBENCH_PORT=3000

# Base URI for dereferenceable resources, e.g. /person/<id> (required)
RESOURCE_BASE_URI=

# Comma- or whitespace-separated path segments to seed at startup.
# Existing rows are preserved. Leave empty to manage paths in the admin UI.
DEREFERENCE_PATHS=

# SQLite database for accounts, sessions, saved queries, and prefixes
WORKBENCH_DB_PATH=./data/workbench.sqlite

# Allow logged-out visitors to access read-only pages (1 or true).
# A saved value in Setup > Access takes precedence until reset.
ALLOW_ANONYMOUS_READ=

# Allow logged-out visitors to use the ask assistant (1 or true).
# A saved value in Setup > Access takes precedence until reset.
ALLOW_ANONYMOUS_ASK=

# Allow logged-out clients to query /sparql and /api/sparql* (1 or true).
# A saved value in Setup > Access takes precedence until reset.
ALLOW_ANONYMOUS_SPARQL=

######################################################################
# CORS
######################################################################

# Cross-origin browser access to the SPARQL endpoint (/sparql). On by
# default, matching the permissive CORS of the triplestore engines behind
# them. Set to 0 or false to serve same-origin browser clients only.
# CORS_ENABLED=

# Allowed origins: * (the default) allows every origin. A comma-separated
# list allows exactly those origins, e.g.
# https://app.example.org,https://map.example.org
# CORS_ALLOWED_ORIGINS=

# Response headers exposed to browser clients beyond the CORS-safelisted
# ones, e.g. Content-Disposition
# CORS_EXPOSE_HEADERS=

######################################################################
# Ask assistant
######################################################################

# OpenAI-compatible API base URL. Empty disables the assistant.
AI_BASE_URL=

# API key for the configured API
AI_API_KEY=

# Chat model
AI_MODEL=

# Optional settings. Values saved under Setup > AI settings take precedence
# until reset. Invalid values fall back to their defaults independently.
# AI_MAX_STEPS=10
# AI_QUERY_TIMEOUT_MS=30000
# AI_JOB_TIMEOUT_MS=900000
# AI_RESULT_LIMIT=1000
# AI_PROFILE_MAX_CLASSES=60
# AI_PROFILE_MAX_PROPERTIES=30
# AI_PROFILE_MAX_SAMPLES=3

######################################################################
# Local accounts
######################################################################

# Initial admin username; used when the users table is empty
BOOTSTRAP_ADMIN_USERNAME=admin

# Initial admin password
BOOTSTRAP_ADMIN_PASSWORD=replace-with-at-least-8-characters

######################################################################
# Oxigraph
######################################################################

# Host port for Oxigraph; SPARQL endpoint is /sparql
OXIGRAPH_PORT=7878

######################################################################
# Virtuoso
######################################################################

# Virtuoso adapter service URL
VIRTUOSO_ADAPTER_URL=http://localhost:50118

# Shared bearer token for the workbench and adapter
VIRTUOSO_ADAPTER_TOKEN=replace-with-at-least-32-characters

# Directory for graph export files inside the container
VIRTUOSO_EXPORT_BASE_PATH=./imports/exports

# Maximum graph dump size in bytes
GRAPH_EXPORT_FILE_LIMIT=50000000000

# Dump file polling interval in milliseconds
GRAPH_EXPORT_POLL_INTERVAL_MS=1000

# Maximum dump file polling attempts
GRAPH_EXPORT_POLL_ATTEMPTS=60

# Virtuoso hostname as seen by the adapter
VIRTUOSO_HOST=host.docker.internal

# Virtuoso ISQL port
VIRTUOSO_ISQL_PORT=1111

# Virtuoso account used by the adapter
VIRTUOSO_DBA_USER=dba

# Password for the Virtuoso account
VIRTUOSO_DBA_PASSWORD=replace-this-password

# ODBC driver path inside the adapter image
VIRTUOSO_DRIVER=/usr/lib/odbc/virtodbc.so

# Connection timeout in seconds
VIRTUOSO_CONNECTION_TIMEOUT=30

# Login timeout in seconds
VIRTUOSO_LOGIN_TIMEOUT=10

# Import staging directory inside the adapter
VIRTUOSO_IMPORTS_PATH=./imports

# Host directory mounted for imports
VIRTUOSO_IMPORTS_HOST_PATH=./virtuoso-database/imports

# Maximum upload size in bytes
VIRTUOSO_ADAPTER_MAX_UPLOAD_BYTES=107374182400
