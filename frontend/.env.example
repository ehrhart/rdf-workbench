# Frontend runtime environment for `next dev` / `next start`.

# Common RDF Workbench configuration
# One of: qlever | virtuoso | oxigraph
TRIPLESTORE_PROVIDER=qlever

# SPARQL endpoint of the triplestore. For oxigraph this must point at the
# /sparql endpoint, e.g. http://localhost:7878/sparql
SPARQL_ENDPOINT=

# Abort SPARQL requests that take longer than this (milliseconds).
SPARQL_TIMEOUT_MS=60000

# Display name shown in the sidebar and login page.
WORKBENCH_NAME=RDF Workbench

# Public origin of the workbench. Must match the origin you browse, since
# it is allowlisted for same-origin mutations.
WORKBENCH_URL=http://localhost:3000

# Base of dereferenceable resource IRIs, e.g. /person/<id> -> <RESOURCE_BASE_URI>/person/<id>
# Required: valid URL, empty fails startup.
RESOURCE_BASE_URI=http://example.org/data

# Workbench sqlite database
WORKBENCH_DB_PATH=./data/workbench.sqlite

# Allow logged-out visitors to open read-only pages (1/true to enable)
ALLOW_ANONYMOUS_READ=

# Local workbench accounts (QLever and Oxigraph). First user is created when
# the users table is empty; password changes in /admin/users.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-at-least-12-characters

###############################################################################
# QLever provider
###############################################################################

# Access token of the QLever server (--access-token). Enables the running-queries monitor.
QLEVER_ACCESS_TOKEN=

###############################################################################
# Virtuoso provider
###############################################################################

# Session cookie secret. Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-at-least-32-characters

# URL and bearer token of the virtuoso-adapter service (see virtuoso-adapter/).
VIRTUOSO_ADAPTER_URL=http://localhost:50118
VIRTUOSO_ADAPTER_TOKEN=replace-with-at-least-32-characters

# Graph export limits and polling.
VIRTUOSO_EXPORT_BASE_PATH=./imports/exports
GRAPH_EXPORT_FILE_LIMIT=50000000000
GRAPH_EXPORT_POLL_INTERVAL_MS=1000
GRAPH_EXPORT_POLL_ATTEMPTS=60
